rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthed() && myProfile().isAdmin == true;
    }
    function isSpectator() {
      return isAuthed() && myProfile().isSpectator == true;
    }
    function isBlocked() {
      return isAuthed() && myProfile().blocked == true;
    }

    // Public-ish directory used to render the "who's coming in" picker
    // BEFORE anyone is signed in. Only name/role/color/blocked — nothing
    // sensitive lives here.
    match /directory/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private member profiles + stats.
    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthed() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastActive', 'activeMinutes', 'messageCount', 'storageUsed']));
      allow delete: if isAdmin();
    }

    // Group Chat — everyone can post text/emoji + emoji reactions,
    // nobody blocked or spectating can write. A sender can delete their
    // own message; admin can delete any message (or wipe the whole room).
    match /messages_group/{msgId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && !isBlocked() && !isSpectator()
                     && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthed() && !isBlocked() && !isSpectator()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      allow delete: if isAdmin() || (isAuthed() && resource.data.senderId == request.auth.uid);
    }

    // Announcements — admin posts, everyone reads, admin can wipe.
    // fileSize check backs up the client-side compression cap so a
    // hand-crafted request can't stuff a huge attachment into Firestore.
    match /messages_announcements/{msgId} {
      allow read: if isAuthed();
      allow create: if isAdmin() && request.resource.data.senderId == request.auth.uid
                     && request.resource.data.fileSize < 950000;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
